# --- data ---------------------------------------------------------------
# Raw archives and derived datasets are large and reproducible:
#   python scripts/download_data.py --all && python scripts/prepare_data.py --all
# Leading slash matters: a bare `data/` also matches src/data/, which silently
# excluded the entire dataset layer of the package.
/data/
!/data/.gitkeep

# --- training / experiment artefacts ------------------------------------
/runs/
*.pt
!yolo11n.pt.placeholder
*.onnx
*.engine

# --- generated outputs ---------------------------------------------------
# Small result JSON/markdown are committed; big renders are not.
outputs/**/*.jpg
outputs/**/*.png
outputs/**/*.mp4
outputs/_*.jpg

# --- session scratch -----------------------------------------------------
*.log
*.parts
chain.sh

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
